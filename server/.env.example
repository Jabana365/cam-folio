# Neon pooled connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API (used by Better Auth)
BETTER_AUTH_URL=http://localhost:3000
# Where the React app runs (CORS + trusted origin)
CLIENT_ORIGIN=http://localhost:5173
# Stripe test-mode secret key (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret: printed by `stripe listen`, or from the Dashboard endpoint in production
STRIPE_WEBHOOK_SECRET=whsec_...
PORT=3000
